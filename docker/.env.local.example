# StatusNeo × Wren AI — local stack variables (all populated).
# run.sh copies this file to docker/.env on first run and fills in
# OPENAI_API_KEY, USER_UUID and PLATFORM automatically.

COMPOSE_PROJECT_NAME=statusneo-wren
PLATFORM=linux/amd64
PROJECT_DIR=.

# service ports (inside the docker network)
WREN_ENGINE_PORT=8080
WREN_ENGINE_SQL_PORT=7432
WREN_AI_SERVICE_PORT=5555
WREN_UI_PORT=3000
IBIS_SERVER_PORT=8000
WREN_UI_ENDPOINT=http://wren-ui:3000

# ai service
QDRANT_HOST=qdrant
SHOULD_FORCE_DEPLOY=1

# vendor key — REQUIRED for AI features (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# versions of the upstream images (wren-ui is built from ./wren-ui)
WREN_PRODUCT_VERSION=0.29.2
WREN_ENGINE_VERSION=0.22.0
WREN_AI_SERVICE_VERSION=0.29.3
IBIS_SERVER_VERSION=0.22.0
WREN_UI_VERSION=0.32.3
WREN_BOOTSTRAP_VERSION=0.1.5

# anonymous id (filled by run.sh)
USER_UUID=

# telemetry is OFF for local runs
TELEMETRY_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
GENERATION_MODEL=gpt-4.1-nano
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ports published on your machine (change on conflict)
HOST_PORT=3000
AI_SERVICE_FORWARD_PORT=5555

EXPERIMENTAL_ENGINE_RUST_VERSION=false
LOCAL_STORAGE=.
